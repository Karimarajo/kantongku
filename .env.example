# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# On a real deployment (Railway/Render/etc.) set this to the HTTPS domain the
# platform gives you — it must match the Google OAuth authorized origin/redirect.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (self-hosted or platform-provided addon).
DATABASE_URL="postgres://user:password@host:5432/kantongku"

# Flat-price package shown on the landing page (before the per-order "kode unik" is added).
PRICE_AMOUNT="49000"
PRICE_LABEL="Akses KantongKu Selamanya"

# Manual payment (no payment gateway): customer scans a static ShopeePay QRIS or
# transfers to this BCA account, matched by hand via the unique nominal.
# Put the actual QR image yourself at public/qris-shopee.png (not created by
# codegen) — the app just references that path, it does not generate the file.
BANK_BCA_ACCOUNT_NUMBER="1234567890"
BANK_BCA_ACCOUNT_NAME="Nama Pemilik Rekening"

# ADMIN_PASSWORD: single shared password for the /admin console (order
# confirmation, user management). Not tied to Google OAuth or the users table.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Google OAuth (Google Identity Services) — used to verify the ID token
# sent from the frontend after Sign in with Google.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# SESSION_COOKIE_SECRET: random secret used to sign the httpOnly session cookies
# (both the customer session_id cookie and the admin admin_session cookie).
SESSION_COOKIE_SECRET="change-me-to-a-long-random-string"

# Resend (https://resend.com) — used by lib/email.ts to send the "Kirim Link
# Login" email from the Admin Console. HTTPS API, not SMTP: hosting platforms
# like Railway commonly block outbound SMTP ports (587/465), so a raw
# nodemailer/SMTP setup will hang and time out there. Get RESEND_API_KEY from
# https://resend.com/api-keys.
#
# Without a verified custom domain, EMAIL_FROM must stay on Resend's shared
# sandbox domain (onboarding@resend.dev) and Resend will only deliver to the
# email address you signed up with — fine for testing, not for real
# customers. Once you verify your own domain in Resend, change EMAIL_FROM to
# an address on that domain (e.g. "KantongKu <no-reply@kantongku.app>") to
# send to anyone.
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="KantongKu <onboarding@resend.dev>"
