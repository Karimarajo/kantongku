# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# On a real deployment (Railway/Render/etc.) set this to the HTTPS domain the
# platform gives you — it must match the Google OAuth authorized origin/redirect
# and is used to build the Midtrans webhook URL ({APP_URL}/api/payment/webhook).
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (self-hosted or platform-provided addon).
DATABASE_URL="postgres://user:password@host:5432/kantongku"

# Midtrans Snap (Sandbox first — set MIDTRANS_IS_PRODUCTION=false for all testing).
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# VITE_MIDTRANS_CLIENT_KEY: same value as MIDTRANS_CLIENT_KEY, exposed to the
# frontend bundle (only VITE_-prefixed vars are ever exposed to the browser).
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"

# Flat-price package shown on the landing page and charged via Snap.
PRICE_AMOUNT="49000"
PRICE_LABEL="Akses KantongKu Selamanya"

# Google OAuth (Google Identity Services) — used to verify the ID token
# sent from the frontend after Sign in with Google.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# SESSION_COOKIE_SECRET: random secret used to sign the httpOnly session cookie.
SESSION_COOKIE_SECRET="change-me-to-a-long-random-string"
