# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# On a real deployment (Railway/Render/etc.) set this to the HTTPS domain the
# platform gives you — it must match the Google OAuth authorized origin/redirect.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (self-hosted or platform-provided addon).
DATABASE_URL="postgres://user:password@host:5432/kantongku"

# Flat-price package shown on the landing page.
PRICE_AMOUNT="49000"
PRICE_LABEL="Akses KantongKu Selamanya"

# Doku Checkout/Invoice (automatic payment link) — the ONLY payment path,
# no manual QRIS/BCA fallback. Order confirmation is automatic via the
# POST /api/payment/doku/notification webhook (signature-verified), not an
# admin button. Get these from the Doku merchant dashboard (sandbox first —
# https://sandbox.doku.com — then production once verified end-to-end).
# DOKU_CLIENT_ID / DOKU_SECRET_KEY: Non-SNAP Checkout API credentials, used
# both to call the create-payment endpoint AND to verify the webhook
# notification's signature (same secret, both directions). NEVER expose
# DOKU_SECRET_KEY to the browser.
DOKU_CLIENT_ID="MY_DOKU_CLIENT_ID"
DOKU_SECRET_KEY="MY_DOKU_SECRET_KEY"
# DOKU_MODE: "sandbox" (default if unset/anything else — safer to fail
# toward test mode) or "production". Only "production" hits the real
# api.doku.com and moves real money.
DOKU_MODE="sandbox"

# ADMIN_PASSWORD: single shared password for the /admin console (order
# confirmation, user management). Not tied to Google OAuth or the users table.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Google OAuth (Google Identity Services) — used to verify the ID token
# sent from the frontend after Sign in with Google.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# SESSION_COOKIE_SECRET: random secret used to sign the httpOnly session cookies
# (both the customer session_id cookie and the admin admin_session cookie).
SESSION_COOKIE_SECRET="change-me-to-a-long-random-string"

# Task 10: lib/email.ts sends every outgoing email (order confirmations,
# "Kirim Link Login", support replies, admin notifications) via plain SMTP
# through nodemailer — NOT Resend's HTTPS API (that was only ever needed on
# Railway, whose outbound SMTP ports 587/465 are blocked; this app's actual
# self-hosted CT101/Docker deployment has no such restriction, so raw SMTP
# works fine and needs no extra API key).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# The mailbox this app authenticates as AND sends "from" — must be a real,
# working mailbox on the SMTP host above (e.g. a Gmail account with an App
# Password, not your normal Google password).
SMTP_USER="marajotechid@gmail.com"
SMTP_PASS="your-smtp-app-password"
EMAIL_FROM="KantongKu <marajotechid@gmail.com>"

# Meta Pixel / Conversions API (CAPI) — tracks the landing page order form as a
# "Lead" event (client Pixel + server CAPI, deduped via a shared event_id) and
# an admin order confirmation as a custom "OrderConfirmed" event (CAPI only).
# All four are OPTIONAL: if left empty, the app just skips tracking entirely
# (order creation/confirmation still work fine) — but WITHOUT these set,
# nothing gets sent to Meta at all, silently, so don't forget them if you
# actually want the ad campaign data.
#
# VITE_META_PIXEL_ID is inlined into the browser bundle at build time (like
# VITE_GOOGLE_CLIENT_ID) — NOT a secret, safe to expose. Get it from Meta
# Events Manager → your Pixel → Pixel ID.
VITE_META_PIXEL_ID="000000000000000"
# META_PIXEL_ID is the SAME numeric ID as VITE_META_PIXEL_ID above, just read
# server-side (process.env, no VITE_ prefix) for the Conversions API call —
# set both to the same value.
META_PIXEL_ID="000000000000000"
# META_CAPI_ACCESS_TOKEN: server-side only, NEVER expose to the browser (no
# VITE_ prefix, never returned in any API response). Generate from Meta Events
# Manager → your Pixel → Settings → Conversions API → Generate Access Token.
META_CAPI_ACCESS_TOKEN="your-capi-access-token"
# META_TEST_EVENT_CODE: paste from Meta Events Manager → Test Events tab while
# developing, to see events land there instead of counting as real traffic.
# Leave this EMPTY in production.
META_TEST_EVENT_CODE=""

# ADMIN_NOTIFY_EMAIL: where the "order baru masuk" notification email goes
# every time a customer submits the order form. Required for that email to
# actually reach anyone useful — without it, the app falls back to sending it
# to EMAIL_FROM itself, which usually isn't a monitored inbox.
ADMIN_NOTIFY_EMAIL="admin@kantongku.app"

# COLLABORATOR_PRICE_AMOUNT: price (IDR, before the per-order "kode unik") for
# inviting a collaborator (Task 2) — a separate, smaller product from
# PRICE_AMOUNT above. Optional: defaults to 17900 in code if unset.
COLLABORATOR_PRICE_AMOUNT="17900"

# Web Push (cicilan-ai-notifikasi Task 5) — VAPID key pair identifying this
# server to push services (FCM/Mozilla/etc). Generate your own pair with:
#   npx web-push generate-vapid-keys
# Leave both empty to disable push entirely — every other feature (including
# the existing in-app/email reminder mechanisms) keeps working normally
# either way, this is purely additive.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Shown to push services as the subject of the VAPID JWT — any mailto: is
# fine, doesn't need to be a real inbox that's monitored.
VAPID_SUBJECT="mailto:admin@kantongku.site"
