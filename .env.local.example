# Local dev server env (Task 1) — copy this file to .env.local and adjust.
# Loaded by docker-compose.local.yml's "app" service (env_file: .env.local).
# NEVER used by production (docker-compose.yml uses plain .env instead).

# DATABASE_URL is NOT needed here — docker-compose.local.yml sets it directly
# so the app container always points at the "postgres" service on the
# compose network, regardless of what's in this file.

# Google OAuth is OPTIONAL for local dev: leave both blank and log in via the
# dev-login-bypass endpoint instead (only enabled because NODE_ENV is forced
# to "development" in docker-compose.local.yml). Only fill these in if you
# specifically want to test the real "Sign in with Google" button locally.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Any string works locally — the admin console at /admin uses this password.
ADMIN_PASSWORD="local-dev-admin"

# Any long random string works locally — signs the session cookies.
SESSION_COOKIE_SECRET="local-dev-session-secret-change-me"

# Everything below is optional for local dev — leave blank to skip that
# integration entirely (Doku, Meta CAPI, push notifications, SMTP email all
# no-op gracefully when unset).
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
PRICE_AMOUNT="49000"
PRICE_LABEL="Akses KantongKu Selamanya"
ADMIN_NOTIFY_EMAIL="admin@kantongku.local"
COLLABORATOR_PRICE_AMOUNT="17900"

# Doku Checkout/Invoice sandbox credentials — REQUIRED to actually test the
# order/payment flow locally (POST /api/payment/create calls the real
# api-sandbox.doku.com, there's no manual-payment fallback to degrade to).
# Get these from Doku's sandbox merchant dashboard (https://sandbox.doku.com).
# Leave blank to skip Doku entirely — order creation will then fail with a
# clear "DOKU_CLIENT_ID / DOKU_SECRET_KEY belum diset" error instead of
# silently doing nothing.
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_MODE="sandbox"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@kantongku.local"
